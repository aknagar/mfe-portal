{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AppHost (https)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/backend/MfePortal.AppHost/bin/Debug/net10.0/MfePortal.AppHost.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/MfePortal.AppHost",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bhttps://localhost:(\\d+)\\b",
        "uriFormat": "https://localhost:{0}/login"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development"
      },
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart"
    },
    {
      "name": "Test: Unit Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build backend",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/backend/MfePortal.Backend.sln",
        "--filter",
        "Category!=Integration&Category!=E2E",
        "--logger",
        "console;verbosity=detailed"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Test: Integration Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build backend",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/backend/MfePortal.Backend.sln",
        "--filter",
        "Category=Integration",
        "--logger",
        "console;verbosity=detailed"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "env": {
        "TESTCONTAINERS_RYUK_DISABLED": "false"
      }
    },
    {
      "name": "Test: E2E Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build backend",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/backend/MfePortal.Backend.sln",
        "--filter",
        "Category=E2E",
        "--logger",
        "console;verbosity=detailed"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Test: All Tests",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build backend",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/backend/MfePortal.Backend.sln",
        "--logger",
        "console;verbosity=detailed"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Test: All Tests (with Coverage)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build backend",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/backend/MfePortal.Backend.sln",
        "--collect:XPlat Code Coverage",
        "--results-directory",
        "${workspaceFolder}/backend/TestResults",
        "--settings",
        "${workspaceFolder}/backend/coverlet.runsettings",
        "--logger",
        "console;verbosity=detailed"
      ],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["AppHost (https)"],
      "preLaunchTask": "build"
    }
  ]
} 
