{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "aspire run",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "MfePortal.AppHost/MfePortal.AppHost.csproj"],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": "$msCompile",
      "isBackground": true
    },
    {
      "label": "aspire deploy test",
      "type": "shell",
      "command": "aspire",
      "args": [
        "deploy",
        "--environment",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "build backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/backend/MfePortal.Backend.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}/frontend/shell"
      },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "build all",
      "dependsOn": ["build backend", "build frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/backend/MfePortal.Backend.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test backend",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}/backend/MfePortal.Backend.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": "test"
    }
  ]
} 
