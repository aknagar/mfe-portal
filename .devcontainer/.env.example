# Development Container Environment Variables
# Copy this file to .env and customize as needed
# IMPORTANT: Never commit the .env file to version control!

# PostgreSQL Configuration
# NOTE: Avoid using '$' in passwords - docker-compose interprets it as variable substitution.
#       If you must use '$', escape it as '$$' (e.g., Pa$$word -> Pa$$$$word in .env)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourSecurePasswordHere

# Optional: Add any additional environment variables below
