{
  "$schema": "https://json.schemastore.org/aspire-8.0.json",
  "resources": {
    "infra-acr": {
      "type": "azure.bicep.v0",
      "path": "infra-acr.module.bicep"
    },
    "infra": {
      "type": "azure.bicep.v0",
      "path": "infra.module.bicep",
      "params": {
        "infra_acr_outputs_name": "{infra-acr.outputs.name}",
        "userPrincipalId": ""
      }
    },
    "postgres": {
      "type": "container.v1",
      "connectionString": "Host={postgres.bindings.tcp.host};Port={postgres.bindings.tcp.port};Username=postgres;Password={postgres-password.value}",
      "image": "docker.io/library/postgres:17.6",
      "deployment": {
        "type": "azure.bicep.v0",
        "path": "postgres-containerapp.module.bicep",
        "params": {
          "infra_outputs_azure_container_apps_environment_default_domain": "{infra.outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_DEFAULT_DOMAIN}",
          "infra_outputs_azure_container_apps_environment_id": "{infra.outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_ID}",
          "postgres_password_value": "{postgres-password.value}"
        }
      },
      "env": {
        "POSTGRES_HOST_AUTH_METHOD": "scram-sha-256",
        "POSTGRES_INITDB_ARGS": "--encoding=UTF8",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "{postgres-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 5432
        }
      }
    },
    "productdb": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=productdb"
    },
    "weatherdb": {
      "type": "value.v0",
      "connectionString": "{postgres.connectionString};Database=weatherdb"
    },
    "redis": {
      "type": "container.v1",
      "connectionString": "{redis.bindings.tcp.host}:{redis.bindings.tcp.port},password={redis-password.value}",
      "image": "docker.io/library/redis:8.2",
      "deployment": {
        "type": "azure.bicep.v0",
        "path": "redis-containerapp.module.bicep",
        "params": {
          "infra_outputs_azure_container_apps_environment_default_domain": "{infra.outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_DEFAULT_DOMAIN}",
          "infra_outputs_azure_container_apps_environment_id": "{infra.outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_ID}",
          "redis_password_value": "{redis-password.value}"
        }
      },
      "entrypoint": "/bin/sh",
      "args": [
        "-c",
        "redis-server --requirepass $REDIS_PASSWORD"
      ],
      "env": {
        "REDIS_PASSWORD": "{redis-password.value}"
      },
      "bindings": {
        "tcp": {
          "scheme": "tcp",
          "protocol": "tcp",
          "transport": "tcp",
          "targetPort": 6379
        }
      }
    },
    "messaging": {
      "type": "azure.bicep.v0",
      "connectionString": "{messaging.outputs.serviceBusEndpoint}",
      "path": "messaging.module.bicep"
    },
    "orders": {
      "type": "value.v0",
      "connectionString": "Endpoint={messaging.outputs.serviceBusEndpoint};EntityPath=orders"
    },
    "augmentservice": {
      "type": "project.v1",
      "path": "../../AugmentService/AugmentService.Api/AugmentService.Api.csproj",
      "deployment": {
        "type": "azure.bicep.v0",
        "path": "augmentservice-containerapp.module.bicep",
        "params": {
          "infra_outputs_azure_container_apps_environment_default_domain": "{infra.outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_DEFAULT_DOMAIN}",
          "infra_outputs_azure_container_apps_environment_id": "{infra.outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_ID}",
          "infra_outputs_azure_container_registry_endpoint": "{infra.outputs.AZURE_CONTAINER_REGISTRY_ENDPOINT}",
          "infra_outputs_azure_container_registry_managed_identity_id": "{infra.outputs.AZURE_CONTAINER_REGISTRY_MANAGED_IDENTITY_ID}",
          "augmentservice_containerimage": "{augmentservice.containerImage}",
          "augmentservice_identity_outputs_id": "{augmentservice-identity.outputs.id}",
          "augmentservice_containerport": "{augmentservice.containerPort}",
          "postgres_password_value": "{postgres-password.value}",
          "messaging_outputs_servicebusendpoint": "{messaging.outputs.serviceBusEndpoint}",
          "messaging_outputs_servicebushostname": "{messaging.outputs.serviceBusHostName}",
          "redis_password_value": "{redis-password.value}",
          "augmentservice_identity_outputs_clientid": "{augmentservice-identity.outputs.clientId}",
          "appinsights_infra_outputs_appinsightsconnectionstring": "{appinsights-infra.outputs.appInsightsConnectionString}",
          "keyvault_outputs_vaulturi": "{keyvault.outputs.vaultUri}"
        }
      },
      "env": {
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EXCEPTION_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_EMIT_EVENT_LOG_ATTRIBUTES": "true",
        "OTEL_DOTNET_EXPERIMENTAL_OTLP_RETRY": "in_memory",
        "ASPNETCORE_FORWARDEDHEADERS_ENABLED": "true",
        "HTTP_PORTS": "{augmentservice.bindings.http.targetPort}",
        "ConnectionStrings__productdb": "{productdb.connectionString}",
        "PRODUCTDB_HOST": "{postgres.bindings.tcp.host}",
        "PRODUCTDB_PORT": "{postgres.bindings.tcp.port}",
        "PRODUCTDB_USERNAME": "postgres",
        "PRODUCTDB_PASSWORD": "{postgres-password.value}",
        "PRODUCTDB_URI": "postgresql://postgres:{postgres-password-uri-encoded.value}@{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/productdb",
        "PRODUCTDB_JDBCCONNECTIONSTRING": "jdbc:postgresql://{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/productdb",
        "PRODUCTDB_DATABASENAME": "productdb",
        "ConnectionStrings__weatherdb": "{weatherdb.connectionString}",
        "WEATHERDB_HOST": "{postgres.bindings.tcp.host}",
        "WEATHERDB_PORT": "{postgres.bindings.tcp.port}",
        "WEATHERDB_USERNAME": "postgres",
        "WEATHERDB_PASSWORD": "{postgres-password.value}",
        "WEATHERDB_URI": "postgresql://postgres:{postgres-password-uri-encoded.value}@{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/weatherdb",
        "WEATHERDB_JDBCCONNECTIONSTRING": "jdbc:postgresql://{postgres.bindings.tcp.host}:{postgres.bindings.tcp.port}/weatherdb",
        "WEATHERDB_DATABASENAME": "weatherdb",
        "ConnectionStrings__messaging": "{messaging.connectionString}",
        "MESSAGING_HOST": "{messaging.outputs.serviceBusHostName}",
        "MESSAGING_URI": "{messaging.outputs.serviceBusEndpoint}",
        "ConnectionStrings__redis": "{redis.connectionString}",
        "REDIS_HOST": "{redis.bindings.tcp.host}",
        "REDIS_PORT": "{redis.bindings.tcp.port}",
        "REDIS_PASSWORD": "{redis-password.value}",
        "REDIS_URI": "redis://:{redis-password-uri-encoded.value}@{redis.bindings.tcp.host}:{redis.bindings.tcp.port}"
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        },
        "https": {
          "scheme": "https",
          "protocol": "tcp",
          "transport": "http",
          "external": true
        }
      }
    },
    "augmentservice-dapr": {
      "type": "dapr.v0",
      "dapr": {
        "application": "augmentservice",
        "appId": "augmentservice",
        "resourcesPath": [
          "../../dapr/components"
        ]
      }
    },
    "frontend": {
      "type": "container.v1",
      "build": {
        "context": "../../../frontend",
        "dockerfile": "../../../frontend/Dockerfile"
      },
      "deployment": {
        "type": "azure.bicep.v0",
        "path": "frontend-containerapp.module.bicep",
        "params": {
          "infra_outputs_azure_container_apps_environment_default_domain": "{infra.outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_DEFAULT_DOMAIN}",
          "infra_outputs_azure_container_apps_environment_id": "{infra.outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_ID}",
          "infra_outputs_azure_container_registry_endpoint": "{infra.outputs.AZURE_CONTAINER_REGISTRY_ENDPOINT}",
          "infra_outputs_azure_container_registry_managed_identity_id": "{infra.outputs.AZURE_CONTAINER_REGISTRY_MANAGED_IDENTITY_ID}",
          "frontend_containerimage": "{frontend.containerImage}"
        }
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "port": 80,
          "targetPort": 1234,
          "external": true
        }
      }
    },
    "diagrid-dashboard": {
      "type": "container.v1",
      "image": "ghcr.io/diagridio/diagrid-dashboard:latest",
      "deployment": {
        "type": "azure.bicep.v0",
        "path": "diagrid-dashboard-containerapp.module.bicep",
        "params": {
          "infra_outputs_azure_container_apps_environment_default_domain": "{infra.outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_DEFAULT_DOMAIN}",
          "infra_outputs_azure_container_apps_environment_id": "{infra.outputs.AZURE_CONTAINER_APPS_ENVIRONMENT_ID}"
        }
      },
      "bindings": {
        "http": {
          "scheme": "http",
          "protocol": "tcp",
          "transport": "http",
          "port": 80,
          "targetPort": 8080,
          "external": true
        }
      }
    },
    "augmentservice-identity": {
      "type": "azure.bicep.v0",
      "path": "augmentservice-identity.module.bicep"
    },
    "augmentservice-roles-messaging": {
      "type": "azure.bicep.v0",
      "path": "augmentservice-roles-messaging.module.bicep",
      "params": {
        "messaging_outputs_name": "{messaging.outputs.name}",
        "principalId": "{augmentservice-identity.outputs.principalId}"
      }
    },
    "postgres-password": {
      "type": "parameter.v0",
      "value": "{postgres-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22
            }
          }
        }
      }
    },
    "postgres-password-uri-encoded": {
      "type": "annotated.string",
      "value": "{postgres-password.value}",
      "filter": "uri"
    },
    "redis-password": {
      "type": "parameter.v0",
      "value": "{redis-password.inputs.value}",
      "inputs": {
        "value": {
          "type": "string",
          "secret": true,
          "default": {
            "generate": {
              "minLength": 22,
              "special": false
            }
          }
        }
      }
    },
    "redis-password-uri-encoded": {
      "type": "annotated.string",
      "value": "{redis-password.value}",
      "filter": "uri"
    }
  }
}