# Backend Environment Variables
# Copy this file to .env.local and fill in real values.
# IMPORTANT: Never commit the .env.local file to version control!

# Azure AD App Registration (Aspire parameters)
# Find these values in the Azure Portal under App Registrations.
# These are identifiers, not secrets — safe to share with the team.
#
# Key format: Parameters__<name> maps to Aspire's AddParameter("<name>").
# The .env.local loader converts __ to : so these resolve as Parameters:AzureAdTenantId etc.
Parameters__AzureAdTenantId=your-tenant-id-here
Parameters__AzureAdClientId=your-client-id-here

# Optional: Add any additional environment variables below
