# Backend Environment Variables
# Copy this file to .env.local at the repo root and fill in real values.
# IMPORTANT: Never commit the .env.local file to version control!

# Azure AD App Registration
# Find these values in the Azure Portal under App Registrations.
# These are identifiers, not secrets — safe to share with the team.
#
# Key format: double-underscore (__) separates config sections.
# AzureAd__TenantId maps to AzureAd:TenantId inside the service.
AzureAd__TenantId=your-tenant-id-here
AzureAd__ClientId=your-client-id-here

# Optional: Add any additional environment variables below
